# Local AI (default)
# LIQUIDAI / LFM2.5 endpoint if not using process defaults

# Ollama local fallback
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama Cloud escalation (optional). Cloud calls are gated by the ShieldFlow
# egress guard and must route through its local proxy (see docs/IMPLEMENTATION_PLAN.md).
OLLAMA_API_KEY=

# LiquidAI ShieldFlow local egress proxy (auto-discovered from ~/.shieldflow).
# Override discovery only if your install differs; never commit the CA bundle.
# HTTPS_PROXY=http://127.0.0.1:47821
# REQUESTS_CA_BUNDLE=~/.shieldflow/certs/sf-ca-bundle.pem

# OVH IMAP (observe-only by default)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Paths
SCAMFIGHTER_DB_PATH=./data/scamfighter.db
SCAMFIGHTER_EVIDENCE_VAULT=~/ScamFighter/evidence
SCAMFIGHTER_PACKS=~/ScamFighter/packs

# Mode: observe | approve | act (default observe)
SCAMFIGHTER_MODE=observe

# Filing MCP (optional) — Spamhaus Submission Portal token from auth.spamhaus.org
# Never commit the real token. Live submit also needs SCAMFIGHTER_ALLOW_LIVE_SUBMIT=1
# and confirm phrase I_CONFIRM_SUBMIT (see mcp_servers/filing/README.md).
SPAMHAUS_API_TOKEN=
SCAMFIGHTER_ALLOW_LIVE_SUBMIT=
# SCAMFIGHTER_PACKS_ALLOW_ABSOLUTE=1  # only if you must load packs outside SCAMFIGHTER_PACKS
# AbuseIPDB (optional enrichment)
ABUSEIPDB_API_KEY=
